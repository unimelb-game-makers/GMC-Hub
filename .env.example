# Supabase — for local dev, use the local CLI stack's printed values
# (`supabase start`), never the hosted production project's keys. Production
# values only ever belong in Vercel's Production environment variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for privileged operations (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Local-dev-only: skip Discord sign-in entirely via /auth/dev-bypass,
# landing in with every app role. Never set this outside local dev.
DEV_BYPASS_AUTH=false

# Discord bot — role sync + notifications.
DISCORD_BOT_TOKEN=
# The club server (guild) ID
DISCORD_GUILD_ID=
# Committee channel where status-transition notifications are posted
DISCORD_NOTIFICATION_CHANNEL_ID=
# Role IDs: subcommittee/committee -> member, committee -> exec
DISCORD_SUBCOMMITTEE_ROLE_ID=
DISCORD_COMMITTEE_ROLE_ID=
DISCORD_PAYMENT_MANAGER_ROLE_ID=
# Set to "false" for local dev so no channel pings or DMs are ever sent to
# real people while testing against local data.
DISCORD_NOTIFICATIONS_ENABLED=false
# Public app URL, used to build a "View" link in Discord notifications
# (no trailing slash). Not needed locally since notifications are off.
APP_URL=

# Resend — sends Elections invite emails (the only feature that emails
# instead of using Discord). Sign up at resend.com, verify a sending domain
# (or leave RESEND_FROM_EMAIL unset to use their onboarding@resend.dev test
# domain, which only delivers to your own verified Resend account email).
# If RESEND_API_KEY isn't set, invites are skipped and logged instead of
# thrown, so the rest of the app keeps working while this is being set up.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
