# Supabase — from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for privileged operations (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Discord bot — used by API routes to send notifications
DISCORD_BOT_TOKEN=
# Committee channel where status-transition notifications are posted
DISCORD_NOTIFICATION_CHANNEL_ID=
# Role IDs to ping on transitions
DISCORD_EXEC_ROLE_ID=
DISCORD_TREASURER_ROLE_ID=
